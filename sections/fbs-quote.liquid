<section class="fbs-quote section" id="quote" aria-label="{{ 'sections.quote.label' | t }}">
  <div class="container fbs-quote__inner">
    <div class="fbs-quote__info">
      {%- if section.settings.heading != blank -%}
        {%- if section.settings.heading_tag == 'h1' -%}
          <h1 class="fbs-quote__heading">{{ section.settings.heading | escape }}</h1>
        {%- else -%}
          <h2 class="fbs-quote__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="fbs-quote__body">{{ section.settings.body }}</p>
      {%- endif -%}

      <a class="fbs-quote__email" href="mailto:{{ section.settings.contact_email }}">
        {{- section.settings.contact_email -}}
      </a>
    </div>

    <div class="fbs-quote__form-wrap">
      <iframe
        id="JotFormIFrame-{{ section.settings.jotform_id }}"
        title="{{ 'sections.quote.label' | t }}"
        onload="window.parent.scrollTo(0,0)"
        allowtransparency="true"
        allow="geolocation; microphone; camera"
        src="https://form.jotform.com/{{ section.settings.jotform_id }}"
        frameborder="0"
        style="min-width:100%;max-width:100%;height:900px;border:none;"
        scrolling="no"
      ></iframe>
      <script src="https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js"></script>
      <script>
        window.jotformEmbedHandler("iframe[id='JotFormIFrame-{{ section.settings.jotform_id }}']", "https://form.jotform.com");
      </script>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quote Request",
  "tag": "div",
  "class": "quote-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Request a Delivery Quote"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Tell us about your delivery and we'll follow up within one business day."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "familybondsolutionsllc@gmail.com"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use Page title (h1) only when this is the main heading of the page it's on.",
      "options": [
        { "value": "h2", "label": "Section heading (h2)" },
        { "value": "h1", "label": "Page title (h1)" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "jotform_id",
      "label": "JotForm form ID",
      "info": "The numeric ID from the JotForm URL (e.g. form.jotform.com/261967084325060 → 261967084325060)",
      "default": "261967084325060"
    }
  ],
  "presets": [
    {
      "name": "Quote Request",
      "settings": {}
    }
  ]
}
{% endschema %}
