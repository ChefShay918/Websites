<section class="fbs-hero" id="hero" aria-label="{{ 'sections.hero.label' | t }}">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2000 | image_tag:
      class: 'fbs-hero__bg-image',
      loading: 'eager',
      fetchpriority: 'high',
      alt: section.settings.image.alt | default: shop.name,
      widths: '750, 1100, 1500, 2000',
      sizes: '100vw'
    }}
  {%- endif -%}

  <div
    class="fbs-hero__overlay"
    style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    aria-hidden="true"
  ></div>

  <div class="container fbs-hero__content">
    {%- if section.settings.location_label != blank -%}
      <span class="fbs-hero__location-pill">{{ section.settings.location_label | escape }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="fbs-hero__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="fbs-hero__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="fbs-hero__ctas">
      {%- if section.settings.primary_cta_label != blank -%}
        <a class="btn btn--primary" href="{{ section.settings.primary_cta_url | default: '#quote' }}">
          {{- section.settings.primary_cta_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_cta_label != blank -%}
        <a class="btn btn--outline" href="{{ section.settings.secondary_cta_url | default: '/pages/apply' }}">
          {{- section.settings.secondary_cta_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <ul class="fbs-hero__trust-row">
      <li>{{ 'sections.hero.trust_same_day' | t }}</li>
      <li>{{ 'sections.hero.trust_licensed' | t }}</li>
      <li>{{ 'sections.hero.trust_hipaa' | t }}</li>
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "class": "hero-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "location_label",
      "label": "Location pill text",
      "default": "Tulsa, Oklahoma"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tulsa's trusted box truck & medical courier"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Same-day box truck delivery, HIPAA-aware medical courier runs, and on-demand pickups across the Tulsa metro."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary button label",
      "default": "Request a Delivery Quote"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary button label",
      "default": "Drive With Us"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {}
    }
  ]
}
{% endschema %}
